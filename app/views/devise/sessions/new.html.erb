<h2>ログイン</h2>

<%= form_with model: resource, url: user_session_path do |f| %>
  <div class="field">
    <%= f.label :メールアドレス %><br>
    <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
  </div>

  <div class="field">
    <%= f.label :パスワード %><br>
    <%= f.password_field :password, autocomplete: "current-password" %>
  </div>

  <br>

  <div class="actions">
    <%= f.submit "ログイン" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
