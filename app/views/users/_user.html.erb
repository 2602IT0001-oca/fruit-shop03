<div id="<%= dom_id user %>">
  <div>
    <strong>Name:</strong>
    <%= user.name %>
  </div>

  <div>
    <strong>Age:</strong>
    <%= user.age %>
  </div>

  <div>
    <strong>Password:</strong>
    <%= user.password %>
  </div>

  <div>
    <strong>Email:</strong>
    <%= user.email %>
  </div>

</div>
