<% if session[:recent_product_ids].present? && !current_user&.admin_flg? %>
  <% viewed_products = Product.where(id: session[:recent_product_ids]).index_by(&:id) %>
  <div>
    <h4>見た商品</h4>
    <% session[:recent_product_ids].each do |id| %>
      <% product = viewed_products[id] %>
      <% next unless product %>
      <div>
        <% if product.photo.attached? %>
          <%= image_tag product.thumbnail, alt: product.name %>
        <% end %>
        <br>
        <%= link_to product.name, product_path(product) %>
      </div>
    <% end %>
  </div>
<% end %>
